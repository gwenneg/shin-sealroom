#!/bin/sh
# Stands in for Claude Code in TestSession: probes the way out from inside the
# sealed agent, and writes what it saw into the repository, so it comes back
# in the session's patch. The repository is TestSession's.
probe() { curl -s -o /dev/null -w '%{http_code}' --max-time 30 "$@"; }
{
  echo "model=$(probe https://api.anthropic.com/v1/messages -H "authorization: Bearer $CLAUDE_CODE_OAUTH_TOKEN" -H 'anthropic-version: 2023-06-01' -H 'content-type: application/json' -d '{"model":"claude-haiku-4-5-20251001","max_tokens":5,"messages":[{"role":"user","content":"hi"}]}')"
  echo "other-host=$(probe https://example.com/)"
  echo "run-repository=$(probe https://api.github.com/repos/octocat/Hello-World)"
  echo "credential-variables=$(env | grep -cE '^[A-Z_]*(TOKEN|KEY)=' )"
  echo "placeholders=$(env | grep -cE '^[A-Z_]*(TOKEN|KEY)=sealroom-placeholder$')"
} > sealroom-e2e.txt
# Then as a plugin would: a commit on a branch, a push and a pull request,
# which the stand-ins record for the review on the host.
git switch -q -c e2e-branch
git add sealroom-e2e.txt
git -c user.name=e2e -c user.email=e2e@sealroom.invalid commit -q -m "Record what the sealed session saw"
git push -q origin e2e-branch
gh pr create --title "Sealed session results" --body "What the session saw" --base master

